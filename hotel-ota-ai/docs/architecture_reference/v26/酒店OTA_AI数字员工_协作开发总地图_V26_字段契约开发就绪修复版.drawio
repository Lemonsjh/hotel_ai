        </mxCell>
        <mxCell id="edge_E003_SC01" edge="1" parent="1" source="mx_N003" style="edgeStyle=none;rounded=0;curved=0;html=1;endArrow=block;strokeWidth=2;strokeColor=#475569;fontSize=10;fontColor=#111827;labelBackgroundColor=#FFFFFF;dashed=0;" target="mx_N004" value="E003｜chain_trigger&lt;br&gt;为什么：权限和配置通过后才能读取业务数据；读取前要检查字段需求。&lt;br&gt;传递：allowed_actions,required_fiel…&lt;br&gt;蓝图:BP10">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge_E004_SC01" edge="1" parent="1" source="mx_N004" style="edgeStyle=none;rounded=0;curved=0;html=1;endArrow=block;strokeWidth=2;strokeColor=#475569;fontSize=10;fontColor=#111827;labelBackgroundColor=#FFFFFF;dashed=0;" target="mx_N005" value="E004｜chain_trigger&lt;br&gt;为什么：经营/诊断/调价/基准线/峰谷都需要统一经营快照作为数据底座。&lt;br&gt;传递：data_gate_result+ROOM/OP/PR字段包&lt;br&gt;蓝图:BP00/BP02/BP03/BP08/BP10">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge_E046_SC01" edge="1" parent="1" source="mx_N005" style="edgeStyle=none;rounded=0;curved=0;html=1;endArrow=block;strokeWidth=2;strokeColor=#475569;fontSize=10;fontColor=#111827;labelBackgroundColor=#FFFFFF;dashed=0;" target="mx_N018" value="E046｜chain_trigger&lt;br&gt;为什么：用户只问经营快报时，经营房态采集结果直接进入消息中台输出，不进入收益决策。&lt;br&gt;传递：operating_snapshot,inventory_…&lt;br&gt;蓝图:BP00/BP10">
