        <mxCell id="edge_E021_p01" edge="1" parent="1" source="mx_N015" style="edgeStyle=none;rounded=0;curved=0;html=1;endArrow=block;strokeWidth=2;strokeColor=#475569;fontSize=10;fontColor=#111827;labelBackgroundColor=#FFFFFF;dashed=0;" target="mx_N018" value="E021｜chain_trigger&lt;br&gt;不需要执行或执行被阻断时，直接把收益建议输出给用户。&lt;br&gt;蓝图:BP00/BP02">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge_E022_p01" edge="1" parent="1" source="mx_N014" style="edgeStyle=none;rounded=0;curved=0;html=1;endArrow=block;strokeWidth=2;strokeColor=#475569;fontSize=10;fontColor=#111827;labelBackgroundColor=#FFFFFF;dashed=0;" target="mx_N018" value="E022｜chain_trigger&lt;br&gt;dry-run、审批校验、执行结果都必须通过消息中台输…&lt;br&gt;蓝图:BP00/BP02/BP10">
