<diagram id="v26_repair_index" name="P15 V26修复索引"><mxGraphModel dx="1422" dy="794" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1200" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="v26_title" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0F172A;strokeColor=#0F172A;fontSize=22;fontColor=#FFFFFF;spacing=8;align=left;verticalAlign=top;" value="V26 修复索引｜蓝图字段 → 来源别名 → Skill/节点/边 IO → 开发验收" vertex="1"><mxGeometry x="60" y="40" width="1650" height="70" as="geometry" /></mxCell><mxCell id="v26_col1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;fontSize=15;fontColor=#1E3A8A;spacing=8;align=left;verticalAlign=top;" value="一、字段事实源&#10;- 功能蓝图是算法字段最高事实源&#10;- 整体架构分析/数据列表是PMS/OTA/外部字段候选池&#10;- 当前项目仅作证据参考，不反向定义字段" vertex="1"><mxGeometry x="60" y="150" width="500" height="220" as="geometry" /></mxCell><mxCell id="v26_col2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0FDF4;strokeColor=#22C55E;fontSize=15;fontColor=#14532D;spacing=8;align=left;verticalAlign=top;" value="二、新增Excel视图&#10;20 蓝图字段原文抽取&#10;21 来源字段别名映射&#10;22 字段命名最终表&#10;23 按Skill开发输入输出&#10;24 字段缺失降级策略&#10;25 开发验收视图" vertex="1"><mxGeometry x="620" y="150" width="500" height="220" as="geometry" /></mxCell><mxCell id="v26_col3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF2F2;strokeColor=#EF4444;fontSize=15;fontColor=#7F1D1D;spacing=8;align=left;verticalAlign=top;" value="三、重点修复&#10;- 待命名字段&#10;- 错误data_type&#10;- 17核心Skill + S14-EXT扩展&#10;- E049/E052/E054/E060边标注&#10;- N022扩展诊断说明" vertex="1"><mxGeometry x="1180" y="150" width="500" height="220" as="geometry" /></mxCell><mxCell id="v26_col4" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#F59E0B;fontSize=15;fontColor=#78350F;spacing=8;align=left;verticalAlign=top;" value="四、开发验收&#10;每个字段必须能回答：&#10;1 蓝图为什么需要&#10;2 真实来源/别名是什么&#10;3 项目英文名是什么&#10;4 进入哪个节点&#10;5 输出给哪个下游&#10;6 缺失时如何降级/阻断" vertex="1"><mxGeometry x="60" y="430" width="780" height="300" as="geometry" /></mxCell><mxCell id="v26_col5" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F3FF;strokeColor=#8B5CF6;fontSize=15;fontColor=#4C1D95;spacing=8;align=left;verticalAlign=top;" value="五、同步范围&#10;- V26 Excel：字段契约与开发视图&#10;- V26 JSON：结构化注册表和治理政策&#10;- V26 drawio：总图、字段治理页和修复索引&#10;注意：drawio主图不画全量蜘蛛网，完整边以03边注册表和场景页为准。" vertex="1"><mxGeometry x="900" y="430" width="780" height="300" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>