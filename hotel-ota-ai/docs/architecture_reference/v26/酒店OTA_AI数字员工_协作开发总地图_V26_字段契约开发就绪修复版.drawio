        </mxCell>
        <mxCell id="edge_E004_SC05" edge="1" parent="1" source="mx_N004" style="edgeStyle=none;rounded=0;curved=0;html=1;endArrow=block;strokeWidth=2;strokeColor=#475569;fontSize=10;fontColor=#111827;labelBackgroundColor=#FFFFFF;dashed=0;" target="mx_N005" value="E004｜chain_trigger&lt;br&gt;为什么：经营/诊断/调价/基准线/峰谷都需要统一经营快照作为数据底座。&lt;br&gt;传递：data_gate_result+ROOM/OP/PR字段包&lt;br&gt;蓝图:BP00/BP02/BP03/BP08/BP10">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge_E005_SC05" edge="1" parent="1" source="mx_N004" style="edgeStyle=none;rounded=0;curved=0;html=1;endArrow=block;strokeWidth=2;strokeColor=#475569;fontSize=10;fontColor=#111827;labelBackgroundColor=#FFFFFF;dashed=0;" target="mx_N006" value="E005｜chain_trigger&lt;br&gt;为什么：需求、行情、调价、活动和基准线需要需求指数。&lt;br&gt;传递：DEM/FNL/ROOM/OP字段包&lt;br&gt;蓝图:BP01">
