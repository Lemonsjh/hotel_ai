        <mxCell id="edge_E001_SC01" edge="1" parent="1" source="mx_N001" style="edgeStyle=none;rounded=0;curved=0;html=1;endArrow=block;strokeWidth=2;strokeColor=#2563EB;fontSize=10;fontColor=#111827;labelBackgroundColor=#FFFFFF;dashed=0;" target="mx_N002" value="E001｜direct_trigger&lt;br&gt;为什么：入口事件必须先经过总控路由，不能直接进入业务Skill。&lt;br&gt;传递：raw_context,intent_candidate&lt;br&gt;蓝图:BP00">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge_E002_SC01" edge="1" parent="1" source="mx_N002" style="edgeStyle=none;rounded=0;curved=0;html=1;endArrow=block;strokeWidth=2;strokeColor=#475569;fontSize=10;fontColor=#111827;labelBackgroundColor=#FFFFFF;dashed=0;" target="mx_N003" value="E002｜chain_trigger&lt;br&gt;为什么：所有业务链路必须先验权；权限不是记忆或用户自称决定。&lt;br&gt;传递：required_skill_chain,scenario…&lt;br&gt;蓝图:BP00/BP10">
