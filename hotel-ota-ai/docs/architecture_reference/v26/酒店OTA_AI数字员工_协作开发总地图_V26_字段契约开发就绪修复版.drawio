        <mxCell id="edge_E030_p01" edge="1" parent="1" source="mx_N005" style="edgeStyle=none;rounded=0;curved=0;html=1;endArrow=block;strokeWidth=2;strokeColor=#475569;fontSize=10;fontColor=#111827;labelBackgroundColor=#FFFFFF;dashed=0;" target="mx_N020" value="E030｜chain_trigger&lt;br&gt;流量峰谷必须基于当前经营、订单、曝光/浏览/支付转化快…&lt;br&gt;蓝图:BP01/BP04">
