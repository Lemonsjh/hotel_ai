        <mxCell id="title_99480" parent="1" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=none;fillColor=none;fontSize=28;fontStyle=1;fontColor=#0F172A;align=center;" value="P14 字段治理支撑页｜不画业务连接，只说明字段关系" vertex="1">
