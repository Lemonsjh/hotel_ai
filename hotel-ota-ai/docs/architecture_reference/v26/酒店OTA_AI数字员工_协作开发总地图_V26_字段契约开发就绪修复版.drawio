        <mxCell id="edge_E003_SC05" edge="1" parent="1" source="mx_N003" style="edgeStyle=none;rounded=0;curved=0;html=1;endArrow=block;strokeWidth=2;strokeColor=#475569;fontSize=10;fontColor=#111827;labelBackgroundColor=#FFFFFF;dashed=0;" target="mx_N004" value="E003｜chain_trigger&lt;br&gt;为什么：权限和配置通过后才能读取业务数据；读取前要检查字段需求。&lt;br&gt;传递：allowed_actions,required_fiel…&lt;br&gt;蓝图:BP10">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge_E006_SC05" edge="1" parent="1" source="mx_N004" style="edgeStyle=none;rounded=0;curved=0;html=1;endArrow=block;strokeWidth=2;strokeColor=#0EA5E9;fontSize=10;fontColor=#111827;labelBackgroundColor=#FFFFFF;dashed=0;" target="mx_N007" value="E006｜direct_or_chain&lt;br&gt;为什么：用户问竞对时直接触发；调价/活动需要竞对参考时链路触发。&lt;br&gt;传递：CMP/PR/DEM字段包&lt;br&gt;蓝图:BP06">
