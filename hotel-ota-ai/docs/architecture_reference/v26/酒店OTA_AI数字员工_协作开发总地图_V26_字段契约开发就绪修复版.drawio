        <mxCell id="edge_E006_p01" edge="1" parent="1" source="mx_N004" style="edgeStyle=none;rounded=0;curved=0;html=1;endArrow=block;strokeWidth=2;strokeColor=#0EA5E9;fontSize=10;fontColor=#111827;labelBackgroundColor=#FFFFFF;dashed=0;" target="mx_N007" value="E006｜direct_or_chain&lt;br&gt;用户问竞对时直接触发；调价/活动需要竞对参考时链路触发。&lt;br&gt;蓝图:BP06">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge_E007_p01" edge="1" parent="1" source="mx_N004" style="edgeStyle=none;rounded=0;curved=0;html=1;endArrow=block;strokeWidth=2;strokeColor=#0EA5E9;fontSize=10;fontColor=#111827;labelBackgroundColor=#FFFFFF;dashed=0;" target="mx_N008" value="E007｜direct_or_chain&lt;br&gt;用户问口碑时直接触发；诊断需要口碑维度时链路触发。&lt;br&gt;蓝图:BP09/BP03">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge_E008_p01" edge="1" parent="1" source="mx_N005" style="edgeStyle=none;rounded=0;curved=0;html=1;endArrow=block;strokeWidth=2;strokeColor=#475569;fontSize=10;fontColor=#111827;labelBackgroundColor=#FFFFFF;dashed=0;" target="mx_N009" value="E008｜chain_trigger&lt;br&gt;OTA健康诊断需要经营、库存、价格快照作为基础证据。&lt;br&gt;蓝图:BP03/BP04">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge_E009_p01" edge="1" parent="1" source="mx_N008" style="edgeStyle=none;rounded=0;curved=0;html=1;endArrow=block;strokeWidth=2;strokeColor=#475569;fontSize=10;fontColor=#111827;labelBackgroundColor=#FFFFFF;dashed=0;" target="mx_N009" value="E009｜chain_trigger&lt;br&gt;口碑结果会影响OTA健康分和诊断动作。&lt;br&gt;蓝图:BP09/BP03">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge_E010_p01" edge="1" parent="1" source="mx_N005" style="edgeStyle=none;rounded=0;curved=0;html=1;endArrow=block;strokeWidth=2;strokeColor=#475569;fontSize=10;fontColor=#111827;labelBackgroundColor=#FFFFFF;dashed=0;" target="mx_N010" value="E010｜chain_trigger&lt;br&gt;销售基准线需要房量、历史指标和经营快照。&lt;br&gt;蓝图:BP08">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge_E011_p01" edge="1" parent="1" source="mx_N010" style="edgeStyle=none;rounded=0;curved=0;html=1;endArrow=block;strokeWidth=2;strokeColor=#475569;fontSize=10;fontColor=#111827;labelBackgroundColor=#FFFFFF;dashed=0;" target="mx_N011" value="E011｜chain_trigger&lt;br&gt;有基准线后才能判断当前进度偏差。&lt;br&gt;蓝图:BP08">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge_E012_p01" edge="1" parent="1" source="mx_N005" style="edgeStyle=none;rounded=0;curved=0;html=1;endArrow=block;strokeWidth=2;strokeColor=#475569;fontSize=10;fontColor=#111827;labelBackgroundColor=#FFFFFF;dashed=0;" target="mx_N011" value="E012｜chain_trigger&lt;br&gt;偏差诊断需要当前实际进度与基准线比较。&lt;br&gt;蓝图:BP08">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge_E013_p01" edge="1" parent="1" source="mx_N006" style="edgeStyle=none;rounded=0;curved=0;html=1;endArrow=block;strokeWidth=2;strokeColor=#475569;fontSize=10;fontColor=#111827;labelBackgroundColor=#FFFFFF;dashed=0;entryX=1;entryY=0;entryDx=0;entryDy=0;" target="mx_N015" value="E013｜chain_trigger&lt;br&gt;需求指数决定调价动作强度和策略保守程度。&lt;br&gt;蓝图:BP01/BP02">
          <mxGeometry relative="1" x="-0.4883" y="7" as="geometry">
            <mxPoint as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="edge_E014_p01" edge="1" parent="1" source="mx_N014" style="edgeStyle=none;rounded=0;curved=0;html=1;endArrow=block;strokeWidth=2;strokeColor=#475569;fontSize=10;fontColor=#111827;labelBackgroundColor=#FFFFFF;dashed=0;" target="mx_N015" value="E014｜chain_trigger&lt;br&gt;竞对只作为收益决策参考，不允许直接进入执行。&lt;br&gt;蓝图:BP06/BP02">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge_E015_p01" edge="1" parent="1" source="mx_N009" style="edgeStyle=none;rounded=0;curved=0;html=1;endArrow=block;strokeWidth=2;strokeColor=#475569;fontSize=10;fontColor=#111827;labelBackgroundColor=#FFFFFF;dashed=0;" target="mx_N015" value="E015｜chain_trigger&lt;br&gt;健康诊断和转化瓶颈决定是否先修转化、口碑或库存，再调价。&lt;br&gt;蓝图:BP03/BP04/BP02">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge_E016_p01" edge="1" parent="1" source="mx_N011" style="edgeStyle=none;rounded=0;curved=0;html=1;endArrow=block;strokeWidth=2;strokeColor=#475569;fontSize=10;fontColor=#111827;labelBackgroundColor=#FFFFFF;dashed=0;entryX=0.25;entryY=0;entryDx=0;entryDy=0;" target="mx_N015" value="E016｜chain_trigger&lt;br&gt;进度落后/超前会改变收益策略，比如补救、观察或涨价。&lt;br&gt;蓝图:BP08/BP02">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge_E017_p01" edge="1" parent="1" source="mx_N012" style="edgeStyle=none;rounded=0;curved=0;html=1;endArrow=block;strokeWidth=2;strokeColor=#475569;fontSize=10;fontColor=#111827;labelBackgroundColor=#FFFFFF;dashed=0;" target="mx_N015" value="E017｜chain_trigger&lt;br&gt;活动可能替代直接降价，也可能影响到手价和底价安全。&lt;br&gt;蓝图:BP05/BP02">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge_E018_p01" edge="1" parent="1" source="mx_N013" style="edgeStyle=none;rounded=0;curved=0;html=1;endArrow=block;strokeWidth=2;strokeColor=#475569;fontSize=10;fontColor=#111827;labelBackgroundColor=#FFFFFF;dashed=0;entryX=0.25;entryY=1;entryDx=0;entryDy=0;" target="mx_N015" value="E018｜chain_trigger&lt;br&gt;ROI或利润模拟是收益最大化策略的增强输入。&lt;br&gt;蓝图:BP08">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge_E019_p01" edge="1" parent="1" source="mx_N014" style="edgeStyle=none;rounded=0;curved=0;html=1;endArrow=block;strokeWidth=2;strokeColor=#475569;fontSize=10;fontColor=#111827;labelBackgroundColor=#FFFFFF;dashed=0;" target="mx_N015" value="E019｜chain_trigger&lt;br&gt;客户结构可作为收益策略和任务建议参考，但不能阻断P0/…&lt;br&gt;蓝图:BP08/BP09">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
