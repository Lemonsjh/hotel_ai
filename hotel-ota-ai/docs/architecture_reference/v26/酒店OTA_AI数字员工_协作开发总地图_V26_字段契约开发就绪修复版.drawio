        <mxCell id="edge_E026_SC05" edge="1" parent="1" source="mx_N018" style="edgeStyle=none;rounded=0;curved=0;html=1;endArrow=block;strokeWidth=2;strokeColor=#9333EA;fontSize=10;fontColor=#111827;labelBackgroundColor=#FFFFFF;dashed=1;" target="mx_N019" value="E026｜async_trigger&lt;br&gt;为什么：用户可见输出可形成脱敏复盘事件，但不阻塞业务主链路。&lt;br&gt;传递：experience_event_candidate&lt;br&gt;蓝图:BP11">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
