# Copy to the production gateway environment on the Alibaba server.
# Never commit real secrets.

HOTEL_OTA_DB=/var/lib/hotel-ota-ai/hotel_ops.sqlite
HOTEL_OTA_LOG_DIR=/var/log/hotel-ota-ai
HOTEL_OTA_ENV=production
HOTEL_OTA_FEISHU_DEBUG=0
HOTEL_OTA_FEISHU_FINAL_GATE_REQUIRED=1
HOTEL_OTA_FEISHU_ALLOW_FILE_EXPORT=0
HOTEL_OTA_FEISHU_ALLOW_CONFIG_EXPORT=0
HOTEL_OTA_FEISHU_ALLOW_RAW_DATA_EXPORT=0
HOTEL_OTA_AUTH_CONFIG=/etc/hotel-ota-ai/feishu-role-map.json
# Optional private mapping used only when the retired S14/综合诊断 entry needs
# to hand off the current trusted group to another diagnosis bot. If the exact
# chat_id is absent from the mapping, the bot must say that this group has not
# configured an independent diagnosis bot instead of guessing one.
HOTEL_OTA_DIAGNOSIS_BOT_CONFIG=/etc/hotel-ota-ai/diagnosis-bot-map.json
HOTEL_OTA_DB_SOURCE_ENABLE=0
HOTEL_OTA_DB_KIND=sqlite
HOTEL_OTA_DB_PROFILE=puyue_mysql_prod
HOTEL_OTA_DB_DSN=
HOTEL_OTA_DB_DSN_PUYUE=
HOTEL_OTA_DB_READONLY=1
HOTEL_OTA_DB_MAPPING_CONFIG=/etc/hotel-ota-ai/database-source.json

# S13 review reply. The source DSN is read-only. The task DSN must use a
# dedicated account limited to SELECT/INSERT/UPDATE on ota_review_reply_task.
HOTEL_OTA_S13_SOURCE_DSN=
HOTEL_OTA_REVIEW_TASK_DSN=
HOTEL_OTA_REVIEW_TASK_WRITE_ENABLED=false
# Optional policy: when true, operator may draft but only owner may confirm.
HOTEL_OTA_S13_REQUIRE_OWNER_CONFIRM=false

# S17 private configuration. Keep the real HMAC secret only on the server.
# The approved room charge subjects are comma-separated and must match RS01 charge_subject values exactly.
HOTEL_OTA_S17_APPROVED_ROOM_CHARGE_SUBJECTS=房费
HOTEL_OTA_S17_CONTACT_HMAC_SECRET=

# Market and business calendar sources. Real location, endpoint, and token
# values stay in /etc/hotel-ota-ai/market-source.json or private env only.
HOTEL_OTA_MARKET_SOURCE_CONFIG=/etc/hotel-ota-ai/market-source.json
OPEN_METEO_API_KEY=
QWEATHER_API_KEY=
HOLIDAY_SOURCE_PROVIDER=apisbo_holidays_year
APISBO_HOLIDAY_BASE_URL=https://api.apisbo.com/holidays/year
JIEJIARI_API_KEY=
JIEJIARI_BASE_URL=https://api.jiejiariapi.com/v1
HOTEL_OTA_EVENT_BRIDGE_TOKEN=

# Production trial price execution no longer calls OTA/Beyondh APIs directly.
# AI writes PENDING rows to configured price task outbox tables; a separate execution plugin
# reads those rows and marks SUCCESS/FAILED.
HOTEL_OTA_PRICE_TASK_WRITE_ENABLE=0
HOTEL_OTA_PRICE_TASK_REQUIRE_CONFIRM=1
HOTEL_OTA_PRICE_TASK_ALLOWED_CHANNELS=ctrip,meituan
# Production hard boundary: when =1, build_auth_context refuses self-declared roles
# from non-feishu sources (manual_test/cli/cron -> guest). Roles must come from
# verified Feishu identity resolution. env-check flags this if not set to 1 in production.
HOTEL_OTA_REQUIRE_VERIFIED_ROLE=1
# Optional override. If empty, follows HOTEL_OTA_DB_KIND / HOTEL_OTA_DB_DSN.
HOTEL_OTA_PRICE_TASK_DB_KIND=
HOTEL_OTA_PRICE_TASK_DB_DSN=

BEYONDH_BASE_URL=https://openapi.beyondh.com
BEYONDH_DOMAIN=replace-with-pms-domain
BEYONDH_CHANNEL_KEY=replace-with-channel-key
BEYONDH_APP_KEY=replace-with-app-key
BEYONDH_SIGN_TYPE=MD5
BEYONDH_ORG_ID=replace-with-org-id

# Deprecated direct API live switch. Keep disabled; production price execution
# must use the price task outbox instead.
BEYONDH_ENABLE_LIVE=0

# Optional reference only. Meituan API permissions and field access are not a
# P0/P1 dependency. Keep empty until the developer account scope is confirmed.
MEITUAN_BASE_URL=https://api-open-cater.meituan.com
MEITUAN_DEVELOPER_ID=
MEITUAN_SIGN_KEY=
MEITUAN_APP_AUTH_TOKEN=
MEITUAN_ENABLE_LIVE=0

# Optional reference only. Dingdanll/order-coming API permissions, RSA keys,
# AES keys, store token, and callback URL must be confirmed before live use.
DINDANLL_BASE_URL=https://open.dingdanll.com
DINDANLL_APP_CODE=
DINDANLL_AUTH_ACCESS_TOKEN=
DINDANLL_VERSION=3.0
DINDANLL_ENABLE_LIVE=0